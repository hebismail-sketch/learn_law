/ios/Runner/GeneratedPluginRegistrant.{h,m}
/linux/flutter/ephemeral/
/macos/Flutter/ephemeral/
/windows/flutter/ephemeral/

# Signing material and anything derived from it. Never committed.
*.jks
*.keystore
/android/keystore-backup/
*.enc
*.enc.sha256
learnlaw-upload-key-*

