<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerColor="#102644"
                android:endColor="#0B101D"
                android:gradientRadius="700dp"
                android:startColor="#143655"
                android:type="radial" />
        </shape>
    </item>
    <!--
      No logo here on purpose. The launch window is a static drawable that is
      decoded before the engine starts, so every pixel of it is paid for on
      every cold start; the full-bleed bitmap that used to sit here is 638 KB
      in a single density folder. Android 12+ draws the branded splash itself
      (values-v31/styles.xml), and on older versions the app's own first frame
      follows within a moment.
    -->
</layer-list>
